<section id="platforms" class="home-deferred relative md:py-24 py-16 bg-gray-50 dark:bg-slate-800">
    <div class="container">
        <div class="grid grid-cols-1 text-center pb-10">
            <h2 class="mb-4 md:text-3xl text-2xl font-semibold">Supported Platforms</h2>
            <p class="max-w-xl mx-auto mb-5">Grab a native binary for your OS <span class="font-semibold">or</span> skip downloads entirely with your built‑in <code>ssh</code>.</p>
        </div>
        <div class="grid lg:grid-cols-5 md:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-[30px] mb-12">
            <a href="/documents/windows" class="group block p-6 rounded-xl shadow bg-white dark:bg-slate-900 hover:bg-indigo-600 dark:hover:bg-indigo-600 transition-all duration-500 text-center">
                <div class="text-indigo-600 group-hover:text-white text-4xl mb-3">
                    <img src="/homepage/images/downloadspage/windows-logo.png" alt="Windows" aria-hidden="true" loading="lazy" decoding="async" class="h-10 w-auto" width="40" height="40" style="margin-inline: auto;">
                </div>
                <h3 class="text-lg font-semibold group-hover:text-white">Windows</h3>
