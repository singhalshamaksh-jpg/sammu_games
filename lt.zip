</section>

<section id="remote-terminal" class="home-deferred" aria-labelledby="remote-terminal-title">
    <div class="rt-fade" aria-hidden="true"></div>
    <div class="rt-glow rt-glow--indigo" aria-hidden="true"></div>
    <div class="rt-glow rt-glow--fuchsia" aria-hidden="true"></div>

    <div class="container rt-container">
        <div class="rt-layout">
            <div class="rt-copy">
                <span class="rt-badge">
                    <span class="rt-badge__new">NEW</span>
                    Device Terminal
                </span>
                <h2 id="remote-terminal-title" class="rt-title">Any machine you own. <span class="rt-accent">A real shell in your browser.</span></h2>
                <p class="rt-lead">Reach your home server, VPS or Raspberry Pi from anywhere, even behind NAT or a firewall. Run one command on the machine, then open its shell in your browser or from any terminal with ssh, and watch CPU, memory and disk live.</p>

                <ul class="rt-chips">
                    <li class="rt-chip">
                        <svg class="home-icon rt-chip__icon rt-chip__icon--emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        No open ports
                    </li>
                    <li class="rt-chip">
                        <svg class="home-icon rt-chip__icon rt-chip__icon--amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                        2FA approval
                    </li>
                    <li class="rt-chip">
                        <svg class="home-icon rt-chip__icon rt-chip__icon--sky" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        Connection records
                    </li>
                    <li class="rt-chip">
                        <svg class="home-icon rt-chip__icon rt-chip__icon--violet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2" ry="2"/><line x1="2" y1="14" x2="4" y2="14"/><line x1="20" y1="14" x2="22" y2="14"/><line x1="15" y1="13" x2="15" y2="15"/><line x1="9" y1="13" x2="9" y2="15"/></svg>
                        Ready for AI agents
                    </li>
                    <li class="rt-chip">
                        <svg class="home-icon rt-chip__icon rt-chip__icon--indigo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        <span dir="ltr" translate="no">Windows · Linux · ARM</span>
                    </li>
                </ul>

                <div class="rt-action">
                    <a href="/devices" class="rt-cta">
                        Open My Devices
                        <svg class="home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                    <span class="rt-free">
                        <svg class="home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        Free
                    </span>
                </div>
            </div>

            <div class="rt-stage" dir="ltr">
                <div class="rt-term" role="img" aria-label="Example terminal: the enable command, an approval code, then a shell session on a device" lang="en" dir="ltr" translate="no">
                    <div class="rt-term__bar">
                        <span class="rt-term__dots"><span></span><span></span><span></span></span>
                        <span class="rt-term__title">deploy@build-box</span>
                        <span class="rt-term__state"><span class="rt-term__state-dot"></span>connected</span>
                    </div>
                    <div class="rt-term__body">
                        <div class="rt-term__comment"># on the machine</div>
                        <div class="rt-term__cmd"><span class="rt-term__prompt">$</span><span>localtonet --terminal enable <span class="rt-term__nowrap">--authtoken <span class="rt-term__token">YOUR_TOKEN</span></span></span></div>
                        <div>Approval code: <span class="rt-term__code">K7QF-M2XR</span></div>
                        <div class="rt-term__muted">Open localtonet.com/devices and enter this code.</div>
                        <div class="rt-term__ok">Terminal enabled. Shells will run as deploy.</div>
                        <div class="rt-term__rule"></div>
                        <div class="rt-term__comment"># in your browser, from My Devices</div>
                        <div class="rt-term__cmd"><span class="rt-term__prompt">deploy@build-box:~$</span><span>uname -sm</span></div>
                        <div>Linux aarch64</div>
                        <div class="rt-term__cmd"><span class="rt-term__prompt">deploy@build-box:~$</span><span>uptime -p</span></div>
                        <div>up 12 days, 4 hours</div>
                        <div class="rt-term__cmd"><span class="rt-term__prompt">deploy@build-box:~$</span><span class="rt-term__cursor"></span></div>
                    </div>
                </div>

                <div class="rt-device" dir="ltr" role="img" aria-label="Example device card: a device shown online with live CPU, RAM and disk usage and a Terminal button">
                    <div class="rt-device__head">
                        <span class="rt-device__icon"><svg class="home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg></span>
                        <span class="rt-device__id">
                            <span class="rt-device__name" dir="ltr" translate="no">build-box</span>
                            <span class="rt-device__os" dir="ltr" translate="no">Linux · ARM64</span>
                        </span>
                        <span class="rt-device__status"><span class="rt-device__dot"></span>Online</span>
                    </div>
                    <div class="rt-meter rt-meter--cpu">
                        <span class="rt-meter__label">CPU</span>
                        <span class="rt-meter__track"><span class="rt-meter__fill"></span></span>
                        <span class="rt-meter__value" dir="ltr"></span>
                    </div>
                    <div class="rt-meter rt-meter--ram">
                        <span class="rt-meter__label">RAM</span>
                        <span class="rt-meter__track"><span class="rt-meter__fill"></span></span>
                        <span class="rt-meter__value" dir="ltr"></span>
                    </div>
                    <div class="rt-meter rt-meter--disk">
                        <span class="rt-meter__label">Disk</span>
                        <span class="rt-meter__track"><span class="rt-meter__fill"></span></span>
                        <span class="rt-meter__value" dir="ltr"></span>
                    </div>
                    <span class="rt-device__button">
                        <svg class="home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                        Terminal
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

