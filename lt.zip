    </div>
</footer>


    <div class="fixed -right-2 theme-switch-wrap" style="top: 60%; z-index: 1000 !important;" title="Drag to move">
    <span class="relative inline-block rotate-90">
        <input type="checkbox"
               class="checkbox opacity-0 absolute"
               id="chk"
               autocomplete="off"
               aria-label="Switch between light and dark theme" />
        <label class="label bg-slate-900 dark:bg-white shadow dark:shadow-gray-800 cursor-pointer rounded-full flex justify-between items-center p-1 w-14 h-8" for="chk">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="pointer-events: none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="pointer-events: none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <span class="ball bg-white dark:bg-slate-900 rounded-full absolute top-[2px] left-[2px] w-7 h-7"></span>
        </label>
    </span>
</div>

<script>
    (function () {
        try {
            var raw = localStorage.getItem("theme-switch-pos");
            if (!raw) return;
            var p = JSON.parse(raw);
            if (typeof p.left !== "number" || typeof p.top !== "number") return;
            var el = document.querySelector(".theme-switch-wrap");
            if (!el) return;
            el.style.left = p.left + "px";
            el.style.top = p.top + "px";
            el.style.setProperty("right", "auto", "important");
            el.style.setProperty("bottom", "auto", "important");
        } catch (e) { }
    })();

    (function () {
        var root = document.documentElement;
        var chk = document.getElementById("chk");
        var ball = document.querySelector(".theme-switch-wrap .ball");
        if (!chk) return;

        function sync(instant) {
            var dark = root.classList.contains("dark");
            if (chk.checked === dark) return;
            if (instant && ball) ball.style.transition = "none";
            chk.checked = dark;
            if (instant && ball) {
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () { ball.style.transition = ""; });
                });
            }
        }

        sync(true);

        if (window.MutationObserver) {
            new MutationObserver(function () { sync(false); }).observe(root, { attributes: true, attributeFilter: ["class"] });
        }

        // A page restored from the back/forward cache keeps the theme it had when it was left; pick up a change
        // made on another page since then.
        window.addEventListener("pageshow", function (e) {
            if (!e.persisted) return;
            var mode = null;
            try { mode = localStorage.getItem("data-theme"); } catch (err) { }
            if (mode === "system") mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            if (mode !== "dark" && mode !== "light") return;
            if (ball) ball.style.transition = "none";
            root.classList.remove(mode === "dark" ? "light" : "dark");
            root.classList.add(mode);
            if (root.hasAttribute("data-theme")) root.setAttribute("data-theme", mode);
            sync(true);
            requestAnimationFrame(function () {
                requestAnimationFrame(function () { if (ball) ball.style.transition = ""; });
            });
        });
    })();
</script>

