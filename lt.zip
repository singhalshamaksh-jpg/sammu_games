    <style>
        .lang-picker { position: relative; font-size: 12px; }
        /* Neutral pill by default (the login page can be light); the dark site footer gets light tones. The list panel is always dark. */
        .lang-picker summary { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; list-style: none; color: #7e8299; padding: 6px 12px; border: 1px solid rgba(126, 130, 153, .35); border-radius: 999px; transition: border-color .15s ease, color .15s ease; }
        .lang-picker summary::-webkit-details-marker { display: none; }
        .lang-picker summary:hover, .lang-picker[open] summary { color: #4f6bff; border-color: #4f6bff; }
        .site-footer-bottom .lang-picker summary { color: #c3cee0; border-color: #29354c; background: rgba(255, 255, 255, .03); }
        .site-footer-bottom .lang-picker summary:hover, .site-footer-bottom .lang-picker[open] summary { color: #fff; border-color: #4f6bff; }
        .lang-picker summary:focus-visible { outline: 2px solid #4f6bff; outline-offset: 2px; }
        .lang-picker-caret { flex: none; opacity: .7; transition: transform .15s ease; }
        .lang-picker[open] .lang-picker-caret { transform: rotate(180deg); }
        .lang-picker-panel { position: absolute; bottom: calc(100% + 6px); inset-inline-start: 0; z-index: 20; display: flex; flex-direction: column; gap: 6px; width: 220px; max-height: min(360px, 60vh); padding: 6px; background: #111a2e; border: 1px solid #29354c; border-radius: 10px; box-shadow: 0 12px 32px rgba(0, 0, 0, .35); }
        .lang-picker-search { flex: none; width: 100%; box-sizing: border-box; padding: 7px 10px; font: inherit; color: #e0e7ff; background: #0b1324; border: 1px solid #29354c; border-radius: 6px; outline: none; }
        .lang-picker-search:focus { border-color: #4f6bff; }
        .lang-picker-search::placeholder { color: #6f7f99; }
        .lang-picker ul { flex: 1 1 auto; min-height: 0; margin: 0; padding: 0; list-style: none; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #29354c transparent; }
        .lang-picker li[hidden] { display: none; }
        .lang-picker form { display: contents; }
        .lang-picker .lang-picker-panel a, .lang-picker .lang-picker-panel button { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; color: #c3cee0; text-decoration: none; }
        .lang-picker .lang-picker-panel button { width: 100%; margin: 0; border: 0; background: none; font: inherit; line-height: inherit; text-align: start; cursor: pointer; }
        .lang-picker-flag { flex: none; border-radius: 50%; object-fit: cover; }
        .lang-picker .lang-picker-panel a:hover, .lang-picker .lang-picker-panel a:focus-visible,
        .lang-picker .lang-picker-panel button:hover, .lang-picker .lang-picker-panel button:focus-visible { background: #1c2740; color: #fff; }
        .lang-picker .lang-picker-panel a[aria-current], .lang-picker .lang-picker-panel button[aria-current] { background: #1c2740; color: #fff; font-weight: 600; }
    </style>
    <script>
        (function () {
            var pickers = document.querySelectorAll('details.lang-picker');
            Array.prototype.forEach.call(pickers, function (picker) {
                if (picker.dataset.ready) return;
                picker.dataset.ready = '1';
                var search = picker.querySelector('.lang-picker-search');
                var list = picker.querySelector('ul');
                var items = Array.prototype.slice.call(list.querySelectorAll('li'));
                search.hidden = false;
                function filter() {
                    var q = search.value.trim().toLowerCase();
                    items.forEach(function (li) { li.hidden = q !== '' && li.getAttribute('data-lang-search').toLowerCase().indexOf(q) < 0; });
                }
                search.addEventListener('input', filter);
                search.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') { picker.open = false; picker.querySelector('summary').focus(); }
                    else if (e.key === 'Enter') {
                        var first = items.filter(function (li) { return !li.hidden; })[0];
                        if (first) { e.preventDefault(); first.querySelector('a, button').click(); }
                    }
                });
                picker.addEventListener('toggle', function () {
                    if (!picker.open) return;
                    search.value = '';
                    filter();
                    var current = list.querySelector('[aria-current]');
                    if (current) list.scrollTop = current.parentNode.offsetTop - list.offsetTop - (list.clientHeight - current.offsetHeight) / 2;
                    search.focus({ preventScroll: true });
                });
                // Plain clicks go through the /language/ switch so the cookie follows the choice (otherwise the cookie
                // would send an English link straight back to the old language); new-tab clicks keep the direct URL.
                list.addEventListener('click', function (e) {
                    var a = e.target.closest ? e.target.closest('a[data-lang-switch]') : null;
                    var switchHref = a ? a.getAttribute('data-lang-switch') : '';
                    if (!switchHref || e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                    e.preventDefault();
                    window.location.href = switchHref;
                });
                document.addEventListener('click', function (e) { if (picker.open && !picker.contains(e.target)) picker.open = false; });
            });
        })();
    </script>

