<script>
    // Floating support/chat widget is not needed for the initial paint, so defer its
    // script until the browser is idle (or shortly after load as a fallback) instead
    // of competing with LCP-critical resources.
    (function () {
        function loadCommunityScript() {
            var s = document.createElement('script');
            s.src = '/community/community.js?v=1.2.1';
            document.body.appendChild(s);
        }

        if ('requestIdleCallback' in window) {
            requestIdleCallback(loadCommunityScript, { timeout: 3000 });
        } else {
            window.addEventListener('load', function () {
                setTimeout(loadCommunityScript, 1000);
            });
        }
    })();
</script>


