                </div>
            </article>

            <!-- File Server -->
            <article class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <div class="text-center">
                    <span class="feature-badge feature-badge-file">
                        <i class="fa-solid fa-cloud-arrow-up"></i> File Sharing
                    </span>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2"><a href="/blog/secure-file-server-tunnels-with-localtonet" class="feature-card-link" target="_blank" rel="noopener noreferrer">File Server</a></h3>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Share any local directory with a secure public link instantly.</p>
                    <div class="feature-list">
                        <div class="feature-list-item"><i class="fa-solid fa-check"></i> Drag &amp; drop sharing</div>
                        <div class="feature-list-item"><i class="fa-solid fa-check"></i> Directory browsing</div>
                        <div class="feature-list-item"><i class="fa-solid fa-check"></i> Download/upload support</div>
                        <div class="feature-list-item"><i class="fa-solid fa-check"></i> Access permissions</div>
                    </div>
                </div>
            </article>

            <!-- Webhook Inspector -->
            <article class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fa-solid fa-bug"></i>
                </div>
                <div class="text-center">
                    <span class="feature-badge feature-badge-debug">
                        <i class="fa-solid fa-magnifying-glass"></i> Debug Tools
                    </span>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2"><a href="/documents/logs-and-inspection" class="feature-card-link" target="_blank" rel="noopener noreferrer">Webhook Inspector</a></h3>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Capture, inspect, replay and modify HTTP traffic in real-time.</p>
                    <div class="feature-list">
