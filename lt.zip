        <script>
            (function () {
                var loaded = false;
                var painted = !(window.PerformanceObserver && (PerformanceObserver.supportedEntryTypes || []).indexOf("paint") >= 0);
                function inject() {
                    var template = document.getElementById("deferred-icon-css");
                    if (loaded && painted && template) {
                        document.head.appendChild(template.content);
                        template.remove();
                    }
                }
                addEventListener("load", function () {
                    loaded = true;
                    inject();
                    // Safety net: never leave the icons unloaded if no paint entry arrives
                    setTimeout(function () { painted = true; inject(); }, 3000);
                });
                if (!painted) {
                    new PerformanceObserver(function (list, observer) {
                        if (list.getEntriesByName("first-contentful-paint").length) {
                            painted = true;
                            observer.disconnect();
                            inject();
                        }
                    }).observe({ type: "paint", buffered: true });
                }
            })();
        </script>

