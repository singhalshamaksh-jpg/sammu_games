                </div>
            </article>

            <!-- Automatic HTTPS -->
            <article class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fa-solid fa-certificate"></i>
                </div>
                <div class="text-center">
                    <span class="feature-badge feature-badge-ssl">
                        <i class="fa-solid fa-shield"></i> Auto SSL
                    </span>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2"><a href="/blog" class="feature-card-link" target="_blank" rel="noopener noreferrer">Automatic HTTPS</a></h3>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Free SSL/TLS certificates auto-provisioned via Let&#x27;s Encrypt.</p>
