<section id="mcp" class="home-deferred relative md:py-24 py-16 overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/10 blur-3xl"></div>
        <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-fuchsia-500/10 blur-3xl"></div>
    </div>
    <div class="container relative">
        <div class="grid grid-cols-1 text-center pb-10">
            <div class="inline-flex items-center gap-2 mx-auto rounded-full px-3 py-1 text-xs font-bold tracking-wide bg-indigo-600/10 text-indigo-700 dark:text-indigo-300 dark:bg-indigo-500/10 mb-4">
                <span class="relative flex h-1.5 w-1.5">
                    <span class="mcp-ping animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-500 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-indigo-600"></span>
                </span>
                NEW
            </div>
            <h2 class="mb-4 md:text-4xl text-2xl font-bold">Localtonet <span class="text-indigo-600 dark:text-indigo-400">MCP</span>: Let Your AI Agent Manage Your Tunnels</h2>
            <p class="max-w-2xl mx-auto mb-5 text-slate-600 dark:text-slate-400">Connect any MCP-compatible AI assistant, such as Claude or Cursor, to Localtonet and manage tunnels, auth tokens, token groups, servers, and SSO providers using natural language.</p>
            <div class="mcp-badges flex flex-wrap items-center justify-center gap-2 mb-10">
                <span class="mcp-badge inline-flex items-center text-xs px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-medium">
                    <i class="fa-solid fa-bolt text-indigo-500 mr-1.5"></i>Streamable HTTP
                </span>
                <span class="mcp-badge inline-flex items-center text-xs px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-medium">
                    <i class="fa-solid fa-lock text-indigo-500 mr-1.5"></i>Bearer Token Auth
                </span>
                <span class="mcp-badge inline-flex items-center text-xs px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-medium">
                    <i class="fa-solid fa-robot text-indigo-500 mr-1.5"></i>Claude, Cursor &amp; More
                </span>
            </div>
        </div>

        <div class="mcp-content-grid grid lg:grid-cols-12 grid-cols-1 gap-8 items-stretch">
            <div class="mcp-feature-card lg:col-span-5 p-6 md:p-8 rounded-2xl shadow bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 dark:shadow-gray-800 flex flex-col">
                <div class="mcp-feature-grid grid sm:grid-cols-2 grid-cols-1 gap-6">
                    <div class="mcp-feature flex items-start gap-3">
                        <div class="mcp-feature-icon mcp-feature-icon-indigo flex-shrink-0 w-11 h-11 rounded-xl bg-indigo-100 dark:bg-indigo-500/20 flex items-center justify-center">
                            <i class="fa-solid fa-robot text-indigo-600 dark:text-indigo-400"></i>
                        </div>
                        <div class="mcp-feature-copy">
                            <h3 class="font-semibold mb-1">Natural Language Control</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400">Ask your AI agent to create, start, stop, or delete tunnels without touching the dashboard.</p>
                        </div>
                    </div>
                    <div class="mcp-feature flex items-start gap-3">
                        <div class="mcp-feature-icon mcp-feature-icon-violet flex-shrink-0 w-11 h-11 rounded-xl bg-violet-100 dark:bg-violet-500/20 flex items-center justify-center">
                            <i class="fa-solid fa-key text-violet-600 dark:text-violet-400"></i>
                        </div>
                        <div class="mcp-feature-copy">
                            <h3 class="font-semibold mb-1">Auth Token Management</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400">Manage auth tokens and token groups directly through conversation with your agent.</p>
                        </div>
                    </div>
                    <div class="mcp-feature flex items-start gap-3">
                        <div class="mcp-feature-icon mcp-feature-icon-emerald flex-shrink-0 w-11 h-11 rounded-xl bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center">
                            <i class="fa-solid fa-server text-emerald-600 dark:text-emerald-400"></i>
                        </div>
                        <div class="mcp-feature-copy">
                            <h3 class="font-semibold mb-1">Server &amp; SSO Management</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400">Configure servers and SSO providers from any MCP-compatible client.</p>
                        </div>
                    </div>
                    <div class="mcp-feature flex items-start gap-3">
                        <div class="mcp-feature-icon mcp-feature-icon-amber flex-shrink-0 w-11 h-11 rounded-xl bg-amber-100 dark:bg-amber-500/20 flex items-center justify-center">
                            <i class="fa-solid fa-shield-halved text-amber-600 dark:text-amber-400"></i>
                        </div>
                        <div class="mcp-feature-copy">
                            <h3 class="font-semibold mb-1">Secure by Design</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400">Authenticated with a Bearer API key over Streamable HTTP transport.</p>
                        </div>
                    </div>
                </div>
                <div class="mcp-actions mt-auto pt-6 flex flex-wrap gap-3">
                    <a href="/documents/mcp-server" class="mcp-action inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition">
                        Learn More<span class="mcp-sr-only"> about Localtonet MCP</span>
                        <i class="fa-solid fa-arrow-right text-xs opacity-90"></i>
                    </a>
                    <a href="https://localtonet.com/.well-known/mcp-server-card" class="mcp-action inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-500/10 hover:bg-indigo-100 dark:hover:bg-indigo-500/20 transition">
                        <i class="fa-solid fa-id-card text-xs"></i>
                        Server Card
                    </a>
                </div>
            </div>

            <div class="lg:col-span-7">
                <div class="mcp-code-block">
                    <div class="mcp-code-header">
                        <div class="mcp-dots" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </div>
                        <div class="mcp-code-title">
                            <span class="mcp-code-icon"><i class="fa-solid fa-plug"></i></span>
                            <span>mcp-server-config.json</span>
                        </div>
                        <button type="button" class="mcp-copy-btn" data-copy-target="mcp-json-snippet" aria-label="Copy MCP configuration" aria-live="polite">
                            <i class="fa-solid fa-copy"></i>
                            <span class="hidden sm:inline">Copy</span>
                        </button>
                    </div>
                    <pre class="mcp-code-body"><code id="mcp-json-snippet"><span class="jp">{</span>
  <span class="jk">"endpoint"</span><span class="jp">:</span> <span class="js">"/mcp"</span><span class="jp">,</span>
  <span class="jk">"transport"</span><span class="jp">:</span> <span class="js">"Streamable HTTP"</span><span class="jp">,</span>
  <span class="jk">"authentication"</span><span class="jp">:</span> <span class="js">"Authorization: Bearer &lt;your-api-key&gt;"</span><span class="jp">,</span>
  <span class="jk">"description"</span><span class="jp">:</span> <span class="js">"Connect any MCP-compatible AI (Claude, Cursor, etc.) to manage your Localtonet tunnels, auth tokens, token groups, servers, and SSO providers via natural language."</span><span class="jp">,</span>
  <span class="jk">"documentationUrl"</span><span class="jp">:</span> <span class="js">"https://localtonet.com/mcp-info"</span><span class="jp">,</span>
  <span class="jk">"serverCard"</span><span class="jp">:</span> <span class="js">"https://localtonet.com/.well-known/mcp-server-card"</span>
<span class="jp">}</span></code></pre>
                </div>
            </div>
        </div>
    </div>


    <script>
        (function () {
            var btn = document.querySelector('#mcp .mcp-copy-btn');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var target = document.getElementById(btn.getAttribute('data-copy-target'));
                if (!target) return;

                var finish = function (ok) {
                    var icon = btn.querySelector('i');
                    var label = btn.querySelector('span');
                    var prevIcon = icon.className;
                    var prevLabel = label.textContent;
                    icon.className = ok ? 'fa-solid fa-check' : 'fa-solid fa-xmark';
                    label.textContent = ok ? "Copied" : "Failed";
                    btn.classList.toggle('is-copied', ok);
                    setTimeout(function () {
                        icon.className = prevIcon;
                        label.textContent = prevLabel;
                        btn.classList.remove('is-copied');
                    }, 1800);
                };

                var text = target.innerText;
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(function () { finish(true); }, function () { finish(false); });
                } else {
                    var ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    var ok = false;
                    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
                    document.body.removeChild(ta);
                    finish(ok);
                }
            });
        })();
    </script>
</section>

